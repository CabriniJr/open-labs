---
import { url } from "../lib/urls";
// O estilo da barra mora em docs.css; o componente o traz, para nenhuma página
// que o use sair com a navegação crua (os índices de labs e de handbooks saíam).
import "../styles/docs.css";
import { chrome, type Lang } from "../lib/chrome-strings";
import { courseAt, pageOf } from "../lib/course-at";
import CourseStep from "./CourseStep.astro";

interface Props {
  lang?: Lang | undefined;
}

const { lang = "en" } = Astro.props;
const t = chrome(lang);
// O fim de uma atividade da trilha é aqui, logo acima do rodapé.
const current = pageOf(Astro.url.pathname);
const course = courseAt(current);
---

{course && <CourseStep handbook={course} current={current} />}

<footer class="site-footer">
  <div>
    <p class="site-footer__title">OpenLabs</p>
    <p class="site-footer__note">
      {t.footerNote}
    </p>
  </div>
  <nav aria-label={t.footerNav}>
    <a href={url("handbooks")}>{t.handbooks}</a>
    <a href={url("docs")}>{t.docs}</a>
    <a href="https://github.com/CabriniJr/open-labs" rel="noopener">{t.code}</a>
    <a
      href="https://github.com/CabriniJr/open-labs/blob/main/LICENSE"
      rel="noopener license">{t.licenseCode}</a
    >
    <a
      href="https://github.com/CabriniJr/open-labs/blob/main/LICENSE-content"
      rel="noopener license">{t.licenseContent}</a
    >
  </nav>
</footer>
