<!-- Os índices de busca nos dois idiomas são gerados depois do build.
     Para testar a busca, use `pnpm build` e o preview. -->
<!-- `hidden` sai no script: sem JavaScript o campo não funciona, e um campo
     morto na tela é pior que campo nenhum. -->
<div class="doc-search" data-search data-pagefind-ignore hidden>
  <label class="doc-search__label" for="doc-search-input">Buscar na documentação</label>
  <input
    id="doc-search-input"
    type="search"
    class="doc-search__input"
    placeholder="Buscar…  (tecle /)"
    autocomplete="off"
    aria-describedby="doc-search-hint"
  />
  <p id="doc-search-hint" class="doc-search__hint">
    <kbd>/</kbd> foca o campo, <kbd>Esc</kbd> limpa.
  </p>
  <div class="doc-search__results" data-results role="region" aria-live="polite"></div>
</div>

<script>
  import { getLanguage } from "../lib/i18n";
  import { searchLocalized, type SearchIndex } from "../lib/localized-search";
  const caixa = document.querySelector<HTMLElement>("[data-search]");
  const campo = document.querySelector<HTMLInputElement>("#doc-search-input");
  const saida = document.querySelector<HTMLElement>("[data-results]");
  if (caixa && campo && saida) {
    caixa.hidden = false;
    const indexes = new Map<string, SearchIndex>();
    let latest = 0;
    async function search() {
      const request = ++latest, query = campo!.value;
      if (query.trim().length < 2) { saida!.replaceChildren(); return; }
      const language = getLanguage();
      try {
        let index = indexes.get(language);
        if (!index) {
          const response = await fetch(`${import.meta.env.BASE_URL}search/${language}.json`);
          if (!response.ok) throw new Error("Search index unavailable");
          index = await response.json() as SearchIndex; indexes.set(language, index);
        }
        if (request !== latest) return;
        const results = searchLocalized(index, query);
        saida!.replaceChildren();
        if (!results.length) {
          const empty = document.createElement("p"); empty.className = "doc-search__empty";
          empty.textContent = "No matching content. Try a broader term or choose a topic from the documentation index.";
          saida!.append(empty); return;
        }
        for (const result of results) {
          const link = document.createElement("a"); link.className = "doc-search__hit";
          link.href = `${import.meta.env.BASE_URL}${result.path}`; link.setAttribute("data-no-translate", "");
          const title = document.createElement("strong"), excerpt = document.createElement("span");
          title.textContent = result.title; excerpt.textContent = result.excerpt; link.append(title, excerpt); saida!.append(link);
        }
      } catch {
        saida!.textContent = "Search is available after building the site. Your current page remains open.";
      }
    }
    campo.addEventListener("input", () => void search());
    campo.addEventListener("keydown", (event) => { if (event.key === "Escape") { campo.value = ""; saida.replaceChildren(); campo.blur(); latest += 1; } });
    document.addEventListener("openlabs:language", () => void search());
    document.addEventListener("keydown", (event) => {
      const target = event.target;
      if (event.key === "/" && !(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || (target instanceof HTMLElement && target.isContentEditable))) { event.preventDefault(); campo.focus(); }
    });
  }
</script>
