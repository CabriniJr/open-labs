---
import type { Handbook } from "../data/handbooks";
import { url } from "../lib/urls";
import { coursePath, positionOf } from "../lib/course-path";
import CourseIcon from "./CourseIcon.astro";
import "./CourseTrail.css";
interface Props { handbook: Handbook; current: string }
const { handbook, current } = Astro.props;
const path = coursePath(handbook);
const { available } = path;
const here = positionOf(path, current, url);
const home = url(`handbooks/${handbook.id}`);
const first = available[0];
---
<aside class="course-sidebar" aria-label="Learning path">
  <details class="course-trail" open data-current={current} data-preference="ovh:course-navigation:v1">
    <summary title="Toggle learning path" aria-label="Toggle learning path">
      <span class="course-ring" data-course-ring style="--p: 0" aria-hidden="true"><CourseIcon name="path" /></span>
      <span class="course-trail__summary">
        <span>Learning path</span>
        <small class="mono" data-course-chip>0 / {available.length}</small>
      </span>
      <CourseIcon name="chevron" class="course-trail__collapse" />
    </summary>
    <div class="course-trail__panel">
      <a class="course-trail__home" href={home} aria-current={current === home ? "page" : undefined}>
        <small class="mono">Handbook</small>
        <span>{handbook.name}</span>
      </a>
      <div class="course-trail__progress" aria-live="polite">
        <div class="course-trail__score">
          <strong data-course-percent>0%</strong>
          <span><span data-course-count>0 / {available.length}</span> <span>available activities</span></span>
        </div>
        <progress class="visually-hidden" max={available.length || 1} value="0" aria-label="Completed learning activities"></progress>
        <ol class="course-trail__strip" aria-hidden="true">
          {path.phases.map((phase) => {
            const n = phase.stops.filter((s) => s.available).length;
            return n > 0 && <li data-phase-bar={phase.number} style={`--n: ${n}; --fill: 0`} title={phase.title}></li>;
          })}
        </ol>
      </div>
      <noscript><p class="course-trail__note">Enable JavaScript to track completion. All course links remain available.</p></noscript>
      <p class="course-trail__note" data-course-storage>Mark activities when you finish. Progress stays in this browser.</p>
      {first ? (
        <a class="course-trail__continue" data-course-continue href={url(first.href!)}>
          <span class="course-trail__continue-text">
            <small data-course-next-label>Start learning</small>
            <span data-course-next-title>{first.title}</span>
          </span>
          <CourseIcon name="arrow" />
        </a>
      ) : <p class="course-trail__note">No activities published yet.</p>}
      <nav aria-label="Course activities">
        {path.phases.map((phase) => (
          <details class="course-trail__phase" data-phase={phase.number} open={!here.phase || here.phase.number === phase.number}>
            <summary>
              <span class="course-trail__badge mono" aria-hidden="true">
                <span>{String(phase.number).padStart(2, "0")}</span>
                <CourseIcon name="check" />
              </span>
              <span class="course-trail__phase-title">{phase.title}</span>
              <small class="mono" data-phase-count></small>
            </summary>
            <ol>
              {phase.stops.map((stop) => (
                <li data-course-item data-title={stop.title} data-kind={stop.kind.toLowerCase()} data-key={stop.key} data-progress-id={stop.progressId} data-available={stop.available ? "true" : "false"}>
                  <span class="course-trail__kind" aria-hidden="true"><CourseIcon name={stop.kind === "Lab" ? "lab" : "article"} /></span>
                  {stop.href ? <>
                    <a id={stop.progressId} href={url(stop.href)} aria-current={url(stop.href) === current ? "page" : undefined}>
                      <small>{stop.kind}{stop.status !== "available" ? ` · ${stop.status}` : ""}</small>
                      <span>{stop.title}</span>
                    </a>
                    {stop.available && (
                      <button type="button" hidden class="course-trail__check" data-course-toggle aria-label="Toggle activity completion" aria-describedby={stop.progressId} aria-pressed="false">
                        <CourseIcon name="check" />
                      </button>
                    )}
                  </> : (
                    <span class="course-trail__unavailable"><small>{stop.kind} · coming</small><span>{stop.title}</span></span>
                  )}
                </li>
              ))}
            </ol>
          </details>
        ))}
      </nav>
      <a class="course-trail__all" href={url("handbooks")}>All handbooks →</a>
    </div>
  </details>
</aside>
<script src="../lib/course-trail-client.ts"></script>
