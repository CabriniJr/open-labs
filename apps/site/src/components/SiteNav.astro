---
interface Props {
  /** Qual item marcar como atual. */
  current?: "home" | "docs" | "handbooks" | "labs" | "studio" | undefined;
  /** A busca só existe onde há o que buscar: nas páginas de documentação. */
  search?: boolean | undefined;
  lang?: Lang | undefined;
}

const { current, search, lang = "en" } = Astro.props;
const t = chrome(lang);
import DocSearch from "./DocSearch.astro";
import { url } from "../lib/urls";
import { chrome, type Lang } from "../lib/chrome-strings";
import { SettingsMenu } from "./SettingsMenu";
import "./SettingsMenu.css";
---

<header class="site-nav">
  <a class="site-nav__skip" href="#content">{t.skip}</a>
  <a class="site-nav__brand" href={url()} aria-current={current === "home" ? "page" : undefined}>
    <span class="site-nav__mark" aria-hidden="true"></span>
    OpenLabs
  </a>
  {search && <DocSearch />}
  <nav aria-label={t.nav}>
    <a href={url("handbooks")} aria-current={current === "handbooks" ? "page" : undefined}
      >{t.handbooks}</a
    >
    <a href={url("labs")} aria-current={current === "labs" ? "page" : undefined}>{t.labs}</a>
    <a href={url("studio")} aria-current={current === "studio" ? "page" : undefined}>Studio</a>
    <a href={url("docs")} aria-current={current === "docs" ? "page" : undefined}>{t.docs}</a>
    <a href="https://github.com/CabriniJr/open-labs" rel="noopener">GitHub</a>
  </nav>
  <SettingsMenu client:load />
</header>
