---
import { GatesLab } from "../../components/GatesLab.tsx";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteNav from "../../components/SiteNav.astro";
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/urls";
import "../../styles/docs.css";
import "../../components/GatesLab.css";
import "@ovh/depth-ui/src/stage.css";
---

<Base
  title="Adding, gate by gate — OpenLabs"
  description="A four-bit ripple-carry adder with every gate modelled: watch the carry climb and see why adding costs depth."
>
  <SiteNav current="handbooks" />

  <main id="content">
    <section class="lab-head editorial">
      <div class="prose">
        <p class="lab-head__eyebrow mono">
          <a href={url("handbooks/riscv")}>RISC-V Visual Handbook</a> · lab
        </p>
        <h1>Adding, gate by gate</h1>
        <p>
          Twenty gates, and not one of them knows how to add. Move the two
          sliders and watch the carry climb from the low bit to the high one —
          the sum appears because the composition is right, not because anything
          here was told the answer.
        </p>
        <p>
          A lit gate is a gate whose output is 1. In this model the presence of a
          message <em>is</em> the high level, so nothing arriving is a zero — and
          a gate sitting dark is a gate whose output really is low.
        </p>
      </div>
      <aside class="lab-head__note mono">
        <p>XOR, AND, OR. No adder anywhere.</p>
        <p>The depth you see is propagation delay.</p>
      </aside>
    </section>

    <section class="lab-stage">
      <GatesLab client:only="react" />
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .lab-head {
    padding-block: var(--space-4) var(--space-2);
  }

  .lab-head__eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--accent);
    font-size: var(--size-step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-step-3);
    max-width: 16ch;
  }

  .lab-head__note {
    align-self: end;
    color: var(--ink-muted);
    font-size: var(--size-step--1);
  }

  .lab-head__note p {
    margin: 0 0 0.35rem;
  }

  .lab-stage {
    max-width: 96rem;
    margin-inline: auto;
    padding: 0 var(--space-3) var(--space-5);
  }
</style>
