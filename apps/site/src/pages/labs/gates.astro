---
import { GatesLab } from "../../components/GatesLab.tsx";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteNav from "../../components/SiteNav.astro";
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/urls";
import "../../styles/docs.css";
import "../../components/GatesLab.css";
import "@ovh/depth-ui/src/stage.css";
import "../../components/Explorer.css";
---

<Base
  title="Adding, gate by gate — OpenLabs"
  description="A four-bit ripple-carry adder with every gate modelled: watch the carry climb and see why adding costs depth."
>
  <SiteNav current="handbooks" />

  <main id="content">
    <section class="lab-head editorial">
      <div class="prose">
        <p class="lab-head__eyebrow mono">
          <a href={url("handbooks/riscv")}>RISC-V Visual Handbook</a> · lab
        </p>
        <h1>Adding, gate by gate</h1>
        <p>
          Twenty gates, and not one of them knows how to add. Move the two
          sliders and watch the carry climb from the low bit to the high one —
          the sum appears because the composition is right, not because anything
          here was told the answer.
        </p>
        <p>
          A lit gate is a gate whose output is 1. Every line in this circuit
          carries its own bit, high or low, so a gate sitting dark is a gate that
          ran and said zero — not a gate that sat still. Set both inputs to zero
          and watch: the whole circuit goes dark, and the depth counter keeps
          reporting the same propagation delay. A ripple-carry adder is slow
          because of its shape, not because of the number you feed it.
        </p>
        <p>
          And the gates open too. Double-click one and you are inside CMOS: a
          pull-up network of PMOS pulling toward 1, a pull-down network of NMOS
          pulling toward 0, and the node where they meet. Nothing down there is
          a lookup table — the answer comes out of transistors switching. An XOR
          costs sixteen of them, which is most of why an adder is expensive.
        </p>
      </div>
      <aside class="lab-head__note mono">
        <p>XOR, AND, OR. No adder anywhere.</p>
        <p>Under them: NAND, NOR, and silicon.</p>
        <p>The depth you see is propagation delay.</p>
      </aside>
    </section>

    <section class="lab-stage">
      <GatesLab client:only="react" />
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .lab-head {
    padding-block: var(--space-4) var(--space-2);
  }

  .lab-head__eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--accent);
    font-size: var(--size-step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-step-3);
    max-width: 16ch;
  }

  .lab-head__note {
    align-self: end;
    color: var(--ink-muted);
    font-size: var(--size-step--1);
  }

  .lab-head__note p {
    margin: 0 0 0.35rem;
  }

  .lab-stage {
    max-width: 96rem;
    margin-inline: auto;
    padding: 0 var(--space-3) var(--space-5);
  }
</style>
