---
import { CpuLab } from "../../components/CpuLab.tsx";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteNav from "../../components/SiteNav.astro";
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/urls";
import "../../styles/docs.css";
import "../../components/CpuLab.css";
import "@ovh/depth-ui/src/stage.css";
---

<Base
  title="The datapath, running — OpenLabs"
  description="Write RISC-V assembly and watch a single-cycle datapath execute it: registers, ALU, control lines and the clock edge, all live."
>
  <SiteNav current="handbooks" />

  <main id="content">
    <section class="lab-head editorial">
      <div class="prose">
        <p class="lab-head__eyebrow mono">
          <a href={url("handbooks/riscv")}>RISC-V Visual Handbook</a> · lab
        </p>
        <h1>The datapath, running</h1>
        <p>
          Write a program on the right and the processor executes it in front of
          you — one instruction per clock. Solid lines carry data, dashed lines
          carry control. The thin ones settle inside the cycle; the thick ones
          cross the clock edge, and the dot travelling on them is the value
          waiting for the flank.
        </p>
        <p>
          Nothing here is scripted. A box lights up because the ledger says it
          acted this tick, so a part that sits still is a part that did nothing.
          Slow the clock down and follow one value through.
        </p>
      </div>
      <aside class="lab-head__note mono">
        <p>Same engine as the OpenTelemetry handbook.</p>
        <p>It does not know what a register is.</p>
      </aside>
    </section>

    <section class="lab-stage">
      <CpuLab client:only="react" />
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .lab-head {
    padding-block: var(--space-4) var(--space-2);
  }

  .lab-head__eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--accent);
    font-size: var(--size-step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-step-3);
    max-width: 16ch;
  }

  .lab-head__note {
    align-self: end;
    color: var(--ink-muted);
    font-size: var(--size-step--1);
  }

  .lab-head__note p {
    margin: 0 0 0.35rem;
  }

  .lab-stage {
    max-width: 96rem;
    margin-inline: auto;
    padding: 0 var(--space-3) var(--space-5);
  }
</style>
