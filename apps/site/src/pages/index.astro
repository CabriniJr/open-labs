---
import { HeroSim } from "../components/HeroSim.tsx";
import { Roadmap } from "../components/Roadmap.tsx";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import DocsState from "../components/DocsState.astro";
import Base from "../layouts/Base.astro";
import { url } from "../lib/urls";
import "../components/HeroSim.css";
import "../components/Roadmap.css";
import "../styles/docs.css";

/**
 * Os quatro níveis são a ideia central do projeto, e até aqui viviam escondidos
 * num parágrafo. Viram peça: quatro faixas, na ordem em que se desce.
 */
const LEVELS = [
  {
    id: "L0",
    name: "Flow",
    line: "Services and telemetry moving between them. The shape of the system.",
  },
  {
    id: "L1",
    name: "Mechanism",
    line: "Inside one component: the processors, the queue, the exporter.",
  },
  { id: "L2", name: "Wire", line: "The channel opened up — HTTP/2 frames, one by one." },
  { id: "L3", name: "Payload", line: "The OTLP message, field by field, with the change lit up." },
] as const;
---

<Base
  title="OTel Visual Handbook"
  description="Every OpenTelemetry concept as a model you can take apart — from the service graph down to the bytes on the wire."
>
  <SiteNav current="home" />

  <main id="content">
    <section class="hero editorial">
      <div>
        <h1>See how the telemetry actually moves.</h1>
        <p class="hero__lede prose">
          Most OpenTelemetry material shows you a diagram and a config file. This
          one gives you the running mechanism: change something, watch the trace
          react, then open it up and read the exact bytes that produced what you
          just saw.
        </p>
        <p class="prose">
          Turn off context propagation below. The picture breaks — and so does
          the payload underneath it, because they are the same data.
        </p>
        <p class="hero__cta">
          <a class="cta cta--primary" href={url("docs")}>Read the documentation</a>
          <a class="cta" href="#path">See the path</a>
        </p>
      </div>
      <aside class="hero__note mono">
        <p>Live simulation. Not a video.</p>
      </aside>
    </section>

    <section class="hero-stage">
      <HeroSim client:visible />
    </section>

    <section class="editorial">
      <div class="prose">
        <h2>What a lab is</h2>
        <p>
          Every lab answers one concrete question, and it answers it four times —
          at four depths. The outside view shows services and telemetry flowing.
          Go one level down and you are inside a component. Another, and you are
          on the wire, in HTTP/2 frames. Another, and you are reading the OTLP
          payload field by field, with whatever just changed still highlighted.
        </p>
        <p>
          Those are not four drawings. They are four views of one running state,
          so what you read at the bottom is what produced the picture at the top.
          When a lab makes a claim, there is a <code>docker compose</code> in the
          repository that lets you check it against a real Collector.
        </p>
      </div>
      <aside class="sidenote">
        <p>
          Sourced from the OpenTelemetry specification and official docs. The
          teaching order follows <em>Learning OpenTelemetry</em>, because the
          order in which the concepts hold each other up is right there.
        </p>
      </aside>
    </section>

    <section class="levels">
      <ol class="levels__list">
        {
          LEVELS.map((level) => (
            <li class="levels__item">
              <span class="levels__id mono">{level.id}</span>
              <span class="levels__name">{level.name}</span>
              <span class="levels__line">{level.line}</span>
            </li>
          ))
        }
      </ol>
      <p class="levels__note mono">
        One run, four projections. Nothing below is drawn by hand.
      </p>
    </section>

    <section class="path" id="path">
      <div class="path__intro">
        <h2>The path</h2>
        <p>
          The phases are not a queue. Instrumentation and pipelines cross; a list
          would hide that, so the map shows it. Click any node to open the lab,
          and mark it off when you are done.
        </p>
      </div>
      <Roadmap client:visible />
      <DocsState />
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-3);
  }

  h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-step-3);
    max-width: 15ch;
  }

  .hero__lede {
    font-size: var(--size-step-1);
  }

  .hero__note {
    align-self: end;
    color: var(--ink-muted);
    font-size: var(--size-step--1);
  }

  .hero-stage,
  .path {
    max-width: 92rem;
    margin-inline: auto;
    padding-inline: var(--space-3);
  }

  .hero-stage {
    padding-block-end: var(--space-5);
  }

  .path {
    padding-block: var(--space-4) var(--space-5);
    border-block-start: 1px solid var(--rule);
  }

  .path__intro {
    max-width: var(--measure);
    margin-block-end: var(--space-3);
  }

  section.editorial {
    padding-block: var(--space-4);
  }

  h2 {
    font-size: var(--size-step-2);
    margin-block: 0 var(--space-2);
  }

  .sidenote {
    color: var(--ink-muted);
    font-size: var(--size-step--1);
    border-block-start: 2px solid var(--accent);
    padding-block-start: var(--space-1);
    align-self: start;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-block-start: var(--space-3);
  }

  .cta {
    display: inline-block;
    padding: 0.5rem var(--space-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-2);
    color: var(--ink);
    font-size: var(--size-step--1);
  }

  .cta:hover {
    border-color: var(--accent);
  }

  .cta--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .levels {
    max-width: 92rem;
    margin-inline: auto;
    padding: 0 var(--space-3) var(--space-4);
  }

  .levels__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-3);
    overflow: hidden;
  }

  .levels__item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-3) var(--space-2);
    background: var(--paper-raised);
  }

  .levels__id {
    color: var(--accent);
    font-size: var(--size-step--1);
    letter-spacing: 0.08em;
  }

  .levels__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--size-step-1);
    letter-spacing: -0.02em;
  }

  .levels__line {
    color: var(--ink-muted);
    font-size: var(--size-step--1);
    line-height: 1.45;
  }

  .levels__note {
    margin: var(--space-2) 0 0;
    color: var(--ink-faint);
    font-size: var(--size-step--1);
  }
</style>
