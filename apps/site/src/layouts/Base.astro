---
import "../styles/tokens.css";
import "../styles/base.css";
import "@ovh/depth-ui/src/depth-ui.css";
import "@ovh/depth-ui/src/trilha.css";
import { HANDBOOKS } from "../data/handbooks";
import { cssDosTemas } from "../lib/tema";

/*
  A identidade de cada handbook, saída do catálogo.

  Eram três arquivos CSS escritos à mão, e nada obrigava um handbook novo a ter
  o dele: ele nascia com a cor da casa e ninguém era avisado. Agora o tema é
  campo do handbook, e este `<style>` é a tradução — a única, e ela não inventa
  token: `lib/tema.ts` tem a lista fechada do que um tema pode pintar.
*/
const temas = cssDosTemas(HANDBOOKS);

interface Props {
  title: string;
  description: string;
  /** A língua da página. O handbook é em inglês; a documentação, em português. */
  lang?: "en" | "pt-BR" | undefined;
  /**
   * O handbook a que a página pertence, que é quem escolhe o tema.
   *
   * Estava fixo em "otel" em toda página do site, inclusive nas do RISC-V —
   * um handbook de CPU pintado com a cor de outro assunto. O padrão continua
   * "otel" porque é a cor da casa; quem pertence a um handbook diz qual.
   */
  domain?: string | undefined;
}

const { title, description, lang = "en", domain = "otel" } = Astro.props;
---

<!doctype html>
<html lang={lang} data-domain={domain}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* A identidade do handbook, gerada do catálogo. Vem antes do resto do
        cabeçalho porque é só declaração de token: ela não pinta nada sozinha. */}
    <style is:global set:html={temas}></style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      // Antes da primeira pintura, senão a página pisca claro e vira escura.
      // Três estados: escolha explícita, ou nada — e aí quem decide é o SO.
      try {
        const salvo = localStorage.getItem("ovh-theme");
        if (salvo === "dark" || salvo === "light") document.documentElement.dataset.theme = salvo;
      } catch {
        // Armazenamento bloqueado: fica valendo a preferência do sistema.
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
