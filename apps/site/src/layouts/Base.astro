---
import "../styles/tokens.css";
import "../styles/themes/otel.css";
import "../styles/base.css";
import "@ovh/depth-ui/src/depth-ui.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-domain="otel">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      // Antes da primeira pintura, senão a página pisca claro e vira escura.
      // Três estados: escolha explícita, ou nada — e aí quem decide é o SO.
      try {
        const salvo = localStorage.getItem("ovh-theme");
        if (salvo === "dark" || salvo === "light") document.documentElement.dataset.theme = salvo;
      } catch {
        // Armazenamento bloqueado: fica valendo a preferência do sistema.
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
