{
  "name": "otel-visual-handbook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "//": "A Vercel N\u00c3O l\u00ea .nvmrc \u2014 ela l\u00ea daqui. Sem este campo o deploy roda numa vers\u00e3o de Node diferente da do CI e da m\u00e1quina, e a primeira coisa que se descobre \u00e9 no build que quebra. Mantenha em dia com .nvmrc.",
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false && tsc -p apps/runner --pretty false",
    "test": "vitest run",
    "boundaries": "node scripts/check-boundaries.mjs",
    "catalogo": "node scripts/check-catalogo.mjs",
    "build": "pnpm --filter @ovh/site build",
    "dev": "pnpm --filter @ovh/site dev",
    "handbooks": "node scripts/handbook.mjs check",
    "codeowners": "node scripts/handbook.mjs codeowners",
    "sdk:pack": "node scripts/sdk-release.mjs",
    "sdk:smoke": "node scripts/sdk-smoke.mjs",
    "delivery:build": "node scripts/delivery.mjs",
    "delivery:smoke": "node scripts/delivery-smoke.mjs",
    "locale:inventory": "node scripts/locale-inventory.mjs",
    "locale:check": "node scripts/check-locales.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^4.9.0",
    "fflate": "^0.8.3",
    "franc-min": "6.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.4"
  },
  "license": "Apache-2.0"
}
