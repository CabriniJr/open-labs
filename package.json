{
  "name": "otel-visual-handbook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "//": "A Vercel NÃO lê .nvmrc — ela lê daqui. Sem este campo o deploy roda numa versão de Node diferente da do CI e da máquina, e a primeira coisa que se descobre é no build que quebra. Mantenha em dia com .nvmrc.",
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "boundaries": "node scripts/check-boundaries.mjs",
    "catalogo": "node scripts/check-catalogo.mjs",
    "build": "pnpm --filter @ovh/site build",
    "dev": "pnpm --filter @ovh/site dev"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "license": "Apache-2.0"
}
